# Meta Model API key from https://dev.meta.ai/ (only the gateway reads it; never the browser)
MODEL_API_KEY=
# Optional overrides
MODEL_API_BASE_URL=https://api.meta.ai/v1
YADORI_SPARK_MODEL=muse-spark-1.3
YADORI_IMAGE_MODEL=muse-image-1.0
YADORI_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
YADORI_SAM_MODEL=sam-3.1
# Daily spend cap for the gateway in USD (estimated from the published prices)
YADORI_DAILY_CAP_USD=3
