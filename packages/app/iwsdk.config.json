{
  "$schema": "./node_modules/@iwsdk/core/dist/schemas/iwsdk-project.v1.schema.json",
  "version": "iwsdk.project.v1",
  "scene": "./public/scenes/main.iwsdk.scene.json",
  "assets": {
    "module": "./src/assets"
  },
  "components": {
    "module": "./src/components"
  },
  "world": {
    "xr": {
      "mode": "ar",
      "offer": "always",
      "features": {
        "handTracking": true,
        "anchors": true,
        "planeDetection": true,
        "meshDetection": true,
        "gazeTracking": true
      }
    },
    "input": {
      "canvasPointerEvents": false
    },
    "render": {
      "fov": 60,
      "near": 0.01,
      "far": 60,
      "camera": {
        "position": [0, 1.55, 1.6],
        "lookAt": [0, 0.85, -2.4]
      }
    },
    "features": {
      "locomotion": false,
      "grabbing": false,
      "physics": false,
      "sceneUnderstanding": true,
      "environmentRaycast": false,
      "spatialUI": false
    }
  },
  "dev": {
    "emulator": {
      "device": "metaQuest3",
      "environment": "sunlit_living_room",
      "injectOnBuild": true,
      "activation": "always",
      "userAgentException": { "source": "OculusBrowser|Quest|Pico|Wolvic|Android|iPhone|iPad|Mobile" }
    }
  }
}
